FROM node:24-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY prisma ./prisma
COPY prisma.config.ts ./
COPY backend ./backend
# ranking.js en playerResult.js worden door frontend én backend gebruikt (één waarheid).
COPY src/utils ./src/utils

ENV DATABASE_URL=postgresql://quiz:quiz@db:5432/quiz
RUN npx prisma generate

EXPOSE 3000

# nodemon herstart de server als je iets in backend/ of het Prisma-schema opslaat.
# Bij een schemawijziging zet het eerst de tabellen bij (db push) en maakt de client opnieuw.
COPY nodemon.json ./
CMD ["npx", "nodemon"]