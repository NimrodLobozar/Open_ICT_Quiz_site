generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  title     String
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  players   Player[]
}

model Player {
  id        Int      @id @default(autoincrement())
  nickname  String
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  quizId    Int
  createdAt DateTime @default(now())
}