# Frontend voor de server (docker-compose.server.yml). Voor development blijft het gewone Dockerfile
# (Vite met live reload) in gebruik.
# Twee stappen: eerst bouwt Node de site (vite build → dist/), daarna serveert nginx alleen die
# bestanden. De uiteindelijke image heeft dus geen Node, geen node_modules en geen broncode.

# Stap 1: bouwen.
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stap 2: serveren. nginx stuurt /api en /socket.io door naar de backend (dat deed eerst de Vite-proxy).
FROM nginx:1.27-alpine
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Zelfde poort als de dev-server, zodat de proxy op de server niet aangepast hoeft te worden.
EXPOSE 5173
