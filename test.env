# Mail-instellingen voor de test-backend (dienst backend-test in docker-compose.yml, poort 3001).
# Gebruikt door npm run test:smoke en npm run test:visual. Altijd Mailpit: deze tests registreren verzonnen
# HU-adressen, en die mogen nooit echt gemaild worden. Je echte instellingen (Brevo) blijven in .env staan.
# Geen geheimen hier, dus dit bestand staat gewoon in git.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@quiz.local
