# Alleen nodig als je de backend ZONDER Docker draait (npm run server). In Docker staan deze in docker-compose.yml.
# DATABASE_URL=postgresql://quiz:quiz@localhost:5433/quiz
DB_TYPE=PostgreSQL (TCP/IP)
DB_HOST=db
DB_PORT=5433
DB_USER=quiz
DB_PASSWORD=quiz
DB_DATABASE=quiz


# Adres van de website, voor links in mails (wachtwoord vergeten, docent-uitnodiging).
# Nooit uit de request gehaald: een aanvaller kan de Host-header vervalsen.
APP_URL=http://localhost:5173

# Eerste beheerder, wordt bij het opstarten aangemaakt als hij nog niet bestaat.
# Op een echte server: een sterk wachtwoord, en na de eerste start mag je deze regels weghalen.
SEED_ADMIN_EMAIL=beheerder@quiz.local
SEED_ADMIN_PASSWORD=Beheerder123
SEED_ADMIN_NAME=Beheerder

# Mail (story 13). Zonder SMTP_HOST komen mails in development in de log (en in productie nergens).
# Mailpit (nep-inbox, http://localhost:8025, start mee met docker compose):
#   SMTP_HOST=localhost en SMTP_PORT=1025, rest leeg.
# Brevo (echte mails), zie docs/MAIL.md. Nooit de echte SMTP_PASS in git zetten: alleen in .env.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<je Brevo SMTP-login, eindigt op @smtp-brevo.com>
#   SMTP_PASS=<je Brevo SMTP-sleutel>
#   MAIL_FROM=<het afzenderadres dat je in Brevo hebt bevestigd>
# Let op: met Docker leest docker-compose.yml deze vijf ook uit .env, voor de gewone backend.
# npm run test:smoke en test:visual gebruiken een aparte test-backend met test.env (altijd Mailpit),
# dus Brevo mag hier gewoon blijven staan als je test.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# production = cookies alleen over HTTPS (secure). Op localhost: development.
NODE_ENV=development
